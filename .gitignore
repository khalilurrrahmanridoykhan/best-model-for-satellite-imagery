# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env
.venv
env/
venv/

# mypy / type checkers
.mypy_cache/

# OS cruft
.DS_Store

# ---------------------------------------------------------------------------
# Project-specific: downloaded imagery, generated labels, and trained model
# weights are all reproducible from scripts/notebooks -- never committed.
# See README.md for how to regenerate everything under data/ and runs/.
# ---------------------------------------------------------------------------
data/raw/*
data/unet/images/*
data/unet/masks/*
data/yolo/images/*
data/yolo/labels/*
!data/raw/.gitkeep
!data/unet/images/.gitkeep
!data/unet/masks/.gitkeep
!data/yolo/images/.gitkeep
!data/yolo/labels/.gitkeep
data/split.json
data/yolo/data.yaml
data/yolo/train.txt
data/yolo/val.txt
data/yolo/test.txt
data/yolo/labels.cache
data/unet/labels.cache
runs/
*.pt
*.pth
*.onnx
.cache/
